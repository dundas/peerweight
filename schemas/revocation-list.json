{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://peerweight.org/schemas/revocation-list.json",
  "title": "PeerWeight Revocation List",
  "description": "Signed list of revoked endorsements and notes",
  "type": "object",
  "required": ["type", "issuer", "updated", "revoked", "proof"],
  "properties": {
    "type": {
      "type": "string",
      "const": "RevocationList",
      "description": "Must be 'RevocationList'"
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:peerweight:",
      "description": "DID of the issuer revoking their own items"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^urn:uuid:",
            "description": "UUID of the item being revoked"
          },
          "type": {
            "type": "string",
            "enum": ["endorsement", "note"],
            "description": "Type of item being revoked"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional human-readable reason for revocation"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this item was revoked"
          }
        }
      },
      "description": "List of revoked items"
    },
    "proof": {
      "type": "object",
      "required": ["type", "proofValue"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Ed25519Signature2020"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        }
      }
    }
  },
  "additionalProperties": false
}
