{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://peerweight.org/schemas/view.json",
  "title": "PeerWeight View",
  "description": "Signed configuration of trust anchors",
  "type": "object",
  "required": ["type", "id", "name", "maintainer", "anchors", "visibility", "created", "proof"],
  "properties": {
    "type": {
      "type": "string",
      "const": "PeerWeightView",
      "description": "Must be 'PeerWeightView'"
    },
    "id": {
      "type": "string",
      "description": "View identifier (typically DID format)",
      "examples": ["did:peerweight:views:indie-cooking"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable view name",
      "examples": ["Indie Cooking", "Tech News Curators", "Academic Papers"]
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of the view's purpose and curation philosophy"
    },
    "maintainer": {
      "type": "string",
      "pattern": "^did:peerweight:",
      "description": "DID of the view maintainer"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["did", "weight"],
        "properties": {
          "did": {
            "type": "string",
            "pattern": "^did:peerweight:",
            "description": "DID of trusted source"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Trust weight for this anchor"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
            },
            "description": "Optional: limit anchor to specific categories"
          }
        }
      },
      "description": "List of trust anchors with weights"
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "unlisted", "private"],
      "description": "Visibility level of the view"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "proof": {
      "type": "object",
      "required": ["type", "proofValue"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Ed25519Signature2020"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        }
      }
    }
  },
  "additionalProperties": false
}
